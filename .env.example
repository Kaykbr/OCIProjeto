# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env (ja esta no .gitignore).
# ============================================================

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Porta em que a aplicacao sobe (a Security List da OCI precisa liberar a mesma)
PORT=8000

# --- Opcionais (tem default no codigo, so preencha se quiser trocar) ---
# Modelo de chat. Se vazio, o app escolhe automaticamente o melhor disponivel na sua chave.
GEMINI_MODEL=
# Modelo de embeddings. Se vazio, idem.
GEMINI_EMBEDDING_MODEL=
# Pastas de dados
CURRICULOS_DIR=data/curriculos
CHROMA_DIR=data/chroma
# Nome da colecao no ChromaDB
CHROMA_COLLECTION=curriculos
# Quantos chunks o retrieval devolve por busca
TOP_K=6
